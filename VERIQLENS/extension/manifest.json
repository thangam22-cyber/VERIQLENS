{
  "manifest_version": 3,
  "name": "VERIQLENS",
  "version": "0.1.0",
  "description": "Shows a Real / Suspicious / Fake badge on images in your social feed.",
  "host_permissions": ["http://localhost:5000/*", "https://*.instagram.com/*", "https://*.cdninstagram.com/*", "https://x.com/*", "https://pbs.twimg.com/*", "https://*.facebook.com/*", "https://*.fbcdn.net/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://*.instagram.com/*", "https://x.com/*", "https://*.facebook.com/*"],
    "js": ["content.js"]
  }]
}
